# apps/web build-time settings. Copy to .env.local (git-ignored) and fill in; never commit real values.

# Cognito user pool and SPA app client (not secrets, but kept out of the repo). Read them from SSM:
#   aws ssm get-parameter --name /sched/<env>/auth/user-pool-id  --query Parameter.Value --output text
#   aws ssm get-parameter --name /sched/<env>/auth/spa-client-id --query Parameter.Value --output text
# Leave both empty on the dev server to sign in to the Cognito mock instead. Set both or neither.
VITE_USER_POOL_ID=
VITE_SPA_CLIENT_ID=

# Dev server only: "off" disables the MSW mock API (and the Cognito mock fallback).
VITE_MOCK_API=
