# apps/web build-time settings. Copy to .env.local (git-ignored) and fill in; never commit real values.

# Cognito user pool and SPA app client (not secrets, but kept out of the repo). Read them from SSM:
#   aws ssm get-parameter --name /sched/<env>/auth/user-pool-id  --query Parameter.Value --output text
#   aws ssm get-parameter --name /sched/<env>/auth/spa-client-id --query Parameter.Value --output text
# Leave both empty on the dev server to sign in to the Cognito mock instead. Set both or neither.
VITE_USER_POOL_ID=
VITE_SPA_CLIENT_ID=

# Identity Pool (voice only, #29): exchanges the ID token for Transcribe-only AWS credentials.
#   aws ssm get-parameter --name /sched/<env>/auth/identity-pool-id --query Parameter.Value --output text
# Optional: without it sign-in still works and the mic shows "Voice input isn't set up" (the dev server on
# the Cognito mock uses the MockTranscriber instead). Ignored when the two IDs above are empty.
VITE_IDENTITY_POOL_ID=

# "1" compiles in voice's timing record and panel, for #29's latency runs on an ephemeral env only
# (VITE_VOICE_TIMING=1 scripts/deploy-web.sh <env>). Leave empty everywhere else.
VITE_VOICE_TIMING=

# Dev server only: "off" disables the MSW mock API (and the Cognito mock fallback).
VITE_MOCK_API=
