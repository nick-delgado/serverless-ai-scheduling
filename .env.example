# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- scripts/seed-users.ts (S1-01 #12): demo patients in the env's Cognito User Pool ----------
# One variable per synthetic fixture patient (packages/tools/fixtures). Only patients with a
# password set are seeded; the username is <first>.<last>, e.g. maria.santos.
# Policy (infra/stacks/auth.yaml): at least 12 characters with lowercase, uppercase and a number.
#   npx tsx scripts/seed-users.ts --env dev --verify
# Writes the git-ignored alias -> Cognito sub mapping to .seed/cognito-users.<env>.json.
DEMO_PASSWORD_MARIA=
DEMO_PASSWORD_WALTER=
DEMO_PASSWORD_AISHA=
DEMO_PASSWORD_DANIEL=
DEMO_PASSWORD_SOFIA=
DEMO_PASSWORD_JAMES=

# --- Escalation email (#35): the verified SES identity (docs/runbooks/aws-setup.md, step 7) -------
# scripts/deploy.sh passes these to the api stack as NoEcho parameters; scripts/retry-escalations.ts
# re-sends with them. dev and demo refuse to deploy the api stack without them. While SES is in the
# sandbox, both must be verified identities (they may be the same address).
# Both scripts parse this file with Node's util.parseEnv, so these read as the bare value: double or single
# quotes, CRLF line endings, an inline `# comment`, an `export ` prefix, and spaces around `=`. An unmatched
# quote is kept as written; if a later line closes it, the value spans lines and deploy.sh refuses it. The
# parsing is the same, but not the choice of value: retry-escalations.ts keeps an environment variable set
# to "" and reads only the repo root's .env, while deploy.sh falls through to the worktree's .env, then the
# main checkout's.
SES_SENDER=
SES_STAFF_RECIPIENT=

# --- Reviewer access page (#357): Cloudflare Turnstile ---------------------------------------------
# Nick creates one Turnstile widget per env in the Cloudflare dashboard (Turnstile -> Add widget; "Managed" mode, the
# env's CloudFront domain as its hostname) and copies its two keys here. Nothing here is needed while the page is off.
#   TURNSTILE_SITE_KEY  the public key. scripts/deploy-web.sh bakes it into the SPA as VITE_TURNSTILE_SITE_KEY when
#                       the env's /sched/<env>/api/request-access says "on".
#   TURNSTILE_SECRET    the secret key. scripts/deploy.sh passes it to the api stack as the NoEcho parameter
#                       TurnstileSecret; `-- RequestAccess=on` refuses to deploy without it.
# Cloudflare's documented test keys work for an ephemeral check env: site key 1x00000000000000000000AA with secret
# 1x0000000000000000000000000000000AA always passes, and 2x0000000000000000000000000000000AA as the secret always fails
# (https://developers.cloudflare.com/turnstile/troubleshooting/testing/). Never use them on an env that matters.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
